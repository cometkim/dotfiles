{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "tools": {
    "lsp": true
  },
  "plugin": [
    "opencode-claude-auth@1.5.0"
  ],
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": [
        "chrome-devtools-mcp",
        "--no-usage-statistics"
      ]
    },
    "zai-mcp-server": {
      "type": "local",
      "command": [
        "zai-mcp-server"
      ],
      "environment": {
        "Z_AI_API_KEY": "{env:ZAI_API_KEY}",
        "Z_AI_MODE": "ZAI"
      }
    },
    "web-search-prime": {
      "type": "remote",
      "url": "https://api.z.ai/api/mcp/web_search_prime/mcp",
      "headers": {
        "Authorization": "Bearer {env:ZAI_API_KEY}"
      }
    },
    "web-reader": {
      "type": "remote",
      "url": "https://api.z.ai/api/mcp/web_reader/mcp",
      "headers": {
        "Authorization": "Bearer {env:ZAI_API_KEY}"
      }
    },
    "zread": {
      "type": "remote",
      "url": "https://api.z.ai/api/mcp/zread/mcp",
      "headers": {
        "Authorization": "Bearer {env:ZAI_API_KEY}"
      }
    },
    "cloudflare-docs": {
      "type": "remote",
      "url": "https://docs.mcp.cloudflare.com/mcp"
    }
  },
  "provider": {
    "cloudflare-ai-gateway:opencode-go": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenCode Go (Gateway)",
      "options": {
        "baseURL": "https://gateway.ai.cloudflare.com/v1/fe86c3d78b514b31fdd1a74181c2c4ce/ai-gateway/custom-opencode-go/zen/go/v1",
        "apiKey": "{env:CF_AIG_TOKEN}"
      },
      "models": {
        "glm-5.1": {
          "name": "GLM-5.1"
        },
        "kimi-k2.6": {
          "name": "Kimi K2.6"
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro"
        },
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash"
        },
        "mimo-v2.5-pro": {
          "name": "MiMo-V2.5-Pro"
        },
        "minimax-m2.7": {
          "name": "MiniMax M2.7"
        },
        "qwen3.6-plus": {
          "name": "Qwen3.6 Plus"
        }
      }
    },
    "cloudflare-ai-gateway:glm-coding-plan": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "GLM Coding Plan (Gateway)",
      "options": {
        "baseURL": "https://gateway.ai.cloudflare.com/v1/fe86c3d78b514b31fdd1a74181c2c4ce/ai-gateway/custom-zai/api/coding/paas/v4",
        "apiKey": "{env:CF_AIG_TOKEN}"
      },
      "models": {
        "glm-5.1": {
          "name": "GLM-5.1"
        }
      }
    },
    "backend.ai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Backend.AI GO",
      "options": {
        "baseURL": "http://localhost:39080/v1"
      },
      "models": {
        "unsloth/Qwen3.5-9B": {}
      }
    }
  }
}
