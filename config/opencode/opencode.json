{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "cloudflare-ai-gateway:glm-coding-plan/glm-4.5-air",
  "autoupdate": false,
  "tools": {
    "lsp": true
  },
  "plugin": [
    "opencode-claude-auth@1.5.4"
  ],
  "mcp": {
    "tokensave": {
      "type": "local",
      "command": [
        "tokensave",
        "serve"
      ]
    },
    "slack": {
      "type": "remote",
      "url": "https://mcp.slack.com/mcp",
      "oauth": {
        "clientId": "1601185624273.8899143856786",
        "redirectUri": "http://localhost:3118/callback"
      }
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "chrome-devtools-mcp",
        "--no-usage-statistics"
      ]
    },
    "zai-mcp-server": {
      "type": "local",
      "command": [
        "zai-mcp-server"
      ],
      "environment": {
        "Z_AI_API_KEY": "{env:ZAI_API_KEY}",
        "Z_AI_MODE": "ZAI"
      }
    },
    "web-search-prime": {
      "type": "remote",
      "url": "https://api.z.ai/api/mcp/web_search_prime/mcp",
      "headers": {
        "Authorization": "Bearer {env:ZAI_API_KEY}"
      }
    },
    "web-reader": {
      "type": "remote",
      "url": "https://api.z.ai/api/mcp/web_reader/mcp",
      "headers": {
        "Authorization": "Bearer {env:ZAI_API_KEY}"
      }
    },
    "zread": {
      "type": "remote",
      "url": "https://api.z.ai/api/mcp/zread/mcp",
      "headers": {
        "Authorization": "Bearer {env:ZAI_API_KEY}"
      }
    },
    "cloudflare-docs": {
      "type": "remote",
      "url": "https://docs.mcp.cloudflare.com/mcp"
    }
  },
  "provider": {
    "cloudflare-ai-gateway:opencode-go:openai-compatible": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenCode Go (Gateway)",
      "options": {
        "baseURL": "https://gateway.ai.cloudflare.com/v1/fe86c3d78b514b31fdd1a74181c2c4ce/ai-gateway/custom-opencode-go/zen/go/v1",
        "apiKey": "{env:CF_AIG_TOKEN}"
      },
      "models": {
        "grok-4.5": {
          "name": "Grok 4.5",
          "limit": {
            "context": 500000,
            "output": 500000
          }
        },
        "glm-5.2": {
          "name": "GLM-5.2",
          "limit": {
            "context": 1000000,
            "output": 131072
          }
        },
        "glm-5.1": {
          "name": "GLM-5.1",
          "limit": {
            "context": 202752,
            "output": 32768
          }
        },
        "kimi-k3": {
          "name": "Kimi K3",
          "limit": {
            "context": 1048576,
            "output": 131072
          }
        },
        "kimi-k2.7-code": {
          "name": "Kimi K2.7 Code",
          "limit": {
            "context": 262144,
            "output": 262144
          }
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro",
          "limit": {
            "context": 1000000,
            "output": 384000
          }
        },
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash",
          "limit": {
            "context": 1000000,
            "output": 384000
          }
        },
        "mimo-v2.5-pro": {
          "name": "MiMo-V2.5-Pro",
          "limit": {
            "context": 1048576,
            "output": 128000
          }
        },
        "mimo-v2.5": {
          "name": "MiMo-V2.5",
          "limit": {
            "context": 1000000,
            "output": 128000
          }
        },
        "hy3": {
          "name": "Hy3",
          "limit": {
            "context": 256000,
            "output": 64000
          }
        }
      }
    },
    "cloudflare-ai-gateway:opencode-go:anthropic": {
      "npm": "@ai-sdk/anthropic",
      "name": "OpenCode Go (Gateway)",
      "options": {
        "baseURL": "https://gateway.ai.cloudflare.com/v1/fe86c3d78b514b31fdd1a74181c2c4ce/ai-gateway/custom-opencode-go/zen/go/v1",
        "apiKey": "{env:OPENCODE_GO_API_KEY}"
      },
      "models": {
        "minimax-m3": {
          "name": "MiniMax M3",
          "limit": {
            "context": 512000,
            "output": 131072
          },
          "headers": {
            "cf-aig-authorization": "Bearer {env:CF_AIG_TOKEN}"
          }
        },
        "qwen3.7-max": {
          "name": "Qwen3.7 Max",
          "limit": {
            "context": 1000000,
            "output": 65536
          },
          "headers": {
            "cf-aig-authorization": "Bearer {env:CF_AIG_TOKEN}"
          }
        },
        "qwen3.7-plus": {
          "name": "Qwen3.7 Plus",
          "limit": {
            "context": 1000000,
            "output": 65536
          },
          "headers": {
            "cf-aig-authorization": "Bearer {env:CF_AIG_TOKEN}"
          }
        }
      }
    },
    "cloudflare-ai-gateway:glm-coding-plan": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Z.AI Coding Plan (Gateway)",
      "options": {
        "baseURL": "https://gateway.ai.cloudflare.com/v1/fe86c3d78b514b31fdd1a74181c2c4ce/ai-gateway/custom-zai/api/coding/paas/v4",
        "apiKey": "{env:CF_AIG_TOKEN}"
      },
      "models": {
        "glm-5.2": {
          "name": "GLM-5.2",
          "limit": {
            "context": 1000000,
            "output": 131072
          },
          "options": {
            "reasoningEffort": "max"
          }
        },
        "glm-5.1": {
          "name": "GLM-5.1",
          "limit": {
            "context": 200000,
            "output": 131072
          }
        }
      }
    },
    "backend.ai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Backend.AI GO",
      "options": {
        "baseURL": "http://localhost:39080/v1"
      },
      "models": {
        "unsloth/Qwen3.5-9B": {
          "limit": {
            "context": 262144,
            "output": 32000
          }
        }
      }
    }
  },
  "instructions": [
    "tokensave.md"
  ]
}
